# All server-only. Never use NEXT_PUBLIC_ prefixes.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Generate a random code of 24–256 characters; share privately.
TRIAGE_ACCESS_CODE=
# Optional on Vercel: defaults to the server-provided VERCEL_URL.
# For local live use, supply a trusted *.vercel.app preview hostname without https://.
# The matching rule must already be published in that project's Firewall.
TRIAGE_FIREWALL_HOST=
TRIAGE_RATE_LIMIT_ID=triage-analysis
# Optional for protected Vercel preview deployments; never expose to the browser.
VERCEL_AUTOMATION_BYPASS_SECRET=
